# 视频社区部署环境变量示例
# 使用：复制为 .env 并修改，docker compose 会自动读取
# 切勿把真实密码提交到 git

# MySQL root 密码（同时用于后端连接）
DB_PASSWORD=请改成强密码

# JWT 签名密钥：生产环境必须换，至少 32 字节随机串
# 生成示例（Linux/macOS）：openssl rand -base64 48
JWT_SECRET=请改成随机长字符串

# RabbitMQ 账号密码（默认 video_community/video_community123 开箱即用；
# 切勿用 guest/guest 跨容器连接——RabbitMQ 限制 guest 仅本机回环可登录）
RABBITMQ_USER=video_community
RABBITMQ_PASSWORD=请改成强密码
